@page "/settings"
@using System.Reflection
@using MonAlbumPc.Core.Media
@implements IDisposable
@inject NasHost Host
@inject NasOptions Options
@inject AdminPassword Password
@inject NavigationManager Navigation
@inject ProvenanceMarker Marker
@inject IDialogService Dialogs

<PageTitle>Réglages · Mon Album PC</PageTitle>

<div class="page settings-page">
    <div class="page-header">
        <h1>Réglages</h1>
    </div>

    <h2 class="section-title">Réseau</h2>
    <div class="settings-card">
        @if (Host.ServerError is { } error)
        {
            <FluentIcon Value="@(new Icons.Filled.Size20.Warning())" Color="Color.Custom" CustomColor="var(--app-caution)" />
            <div class="settings-text">
                <div class="settings-title">Les téléphones ne peuvent pas joindre ce serveur</div>
                <div class="caption">@error</div>
            </div>
        }
        else
        {
            <FluentIcon Value="@(new Icons.Regular.Size20.Router())" Color="Color.Custom" CustomColor="currentColor" />
            <div class="settings-text">
                <div class="settings-title">Prêt à recevoir les photos</div>
                <div class="caption">
                    @(Host.LanAddress is { } address
                        ? $"Adresse {address} · ports {Host.ApiPort} et {Host.DownloadPort}"
                        : "Ce serveur n'est connecté à aucun réseau.")
                </div>
            </div>
        }
    </div>
    <div class="settings-card">
        <FluentIcon Value="@(new Icons.Regular.Size20.Globe())" Color="Color.Custom" CustomColor="currentColor" />
        <div class="settings-text">
            <div class="settings-title">Interface d'administration</div>
            <div class="caption">Port @Options.AdminPort (HTTPS) · nom annoncé aux téléphones : @Host.Core.PcName</div>
        </div>
    </div>
    <div class="settings-card">
        <FluentIcon Value="@(new Icons.Regular.Size20.Folder())" Color="Color.Custom" CustomColor="currentColor" />
        <div class="settings-text">
            <div class="settings-title">Dossier des photos</div>
            <div class="caption">
                Les albums sont rangés dans <span class="mono">@Options.PhotosRoot</span>. Les PC en mode Visionneuse consultent
                ce dossier à travers le partage réseau.
            </div>
        </div>
    </div>

    <h2 class="section-title">Photos</h2>
    <div class="settings-card column">
        <div class="settings-row">
            <FluentIcon Value="@(new Icons.Regular.Size20.Tag())" Color="Color.Custom" CustomColor="currentColor" />
            <div class="settings-text">
                <div class="settings-title">Marquer la provenance des fichiers existants</div>
                <div class="caption">
                    Ajoute aux photos déjà rangées le mot-clé « WhatsApp », « Capture d'écran » ou le nom de l'application
                    d'origine, comme le fait maintenant chaque sauvegarde. Il apparaît dans les « Mots clés » de l'Explorateur
                    Windows et dans les logiciels photo. L'image n'est pas réenregistrée et le fichier garde sa date.
                </div>
            </div>
            @switch (Marker.State)
            {
                case ProvenanceMarkerState.Idle or ProvenanceMarkerState.Done or ProvenanceMarkerState.Failed:
                    <FluentButton IconStart="@(new Icons.Regular.Size20.Search())" OnClick="Marker.Prepare">
                        @(Marker.State == ProvenanceMarkerState.Idle ? "Analyser les photos" : "Analyser à nouveau")
                    </FluentButton>
                    break;
                case ProvenanceMarkerState.Planned:
                    <FluentButton OnClick="Marker.Reset">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" Disabled="@(Marker.Plan?.Files.Count is null or 0)" OnClick="ConfirmMarking">
                        Marquer…
                    </FluentButton>
                    break;
                default:
                    <FluentButton OnClick="Marker.Cancel">Arrêter</FluentButton>
                    break;
            }
        </div>
        @if (Marker.IsBusy)
        {
            var progress = Marker.Progress;
            <div class="settings-detail">
                <div>@ProgressText(progress)</div>
                @if (progress.Total > 0)
                {
                    <FluentProgress Min="0" Max="@progress.Total" Value="@progress.Done" />
                }
                else
                {
                    <FluentProgress />
                }
                <div class="caption">@TimeText()</div>
            </div>
        }
        else if (Marker.State == ProvenanceMarkerState.Planned && Marker.Plan is { } plan)
        {
            <div class="settings-detail">
                <FluentMessageBar Intent="MessageIntent.Info" AllowDismiss="false">@plan.Description</FluentMessageBar>
            </div>
        }
        else if (Marker.State == ProvenanceMarkerState.Done && Marker.Summary is { } summary)
        {
            <div class="settings-detail">
                <FluentMessageBar Intent="@(summary.Problems.Count == 0 ? MessageIntent.Success : MessageIntent.Warning)" AllowDismiss="false">
                    Terminé en @Duration(summary.Duration) : @summary.Description
                </FluentMessageBar>
                @if (summary.Problems.Count > 0)
                {
                    <ul class="settings-problems caption">
                        @foreach (var problem in summary.Problems.Take(MaxProblems))
                        {
                            <li><span class="mono">@Path.GetFileName(problem.Path)</span> : @problem.Reason</li>
                        }
                        @if (summary.Problems.Count > MaxProblems)
                        {
                            <li>… et @Formatting.Plural(summary.Problems.Count - MaxProblems, "autre", "autres") (voir le journal du conteneur)</li>
                        }
                    </ul>
                }
            </div>
        }
        else if (Marker.State == ProvenanceMarkerState.Failed)
        {
            <div class="settings-detail">
                <FluentMessageBar Intent="MessageIntent.Error" AllowDismiss="false">Marquage interrompu : @Marker.Error</FluentMessageBar>
            </div>
        }
    </div>

    <h2 class="section-title">Application Android</h2>
    <div class="settings-card">
        <FluentIcon Value="@(new Icons.Regular.Size20.Phone())" Color="Color.Custom" CustomColor="currentColor" />
        <div class="settings-text">
            <div class="settings-title">Mon Album PC pour Android</div>
            <div class="caption">
                @(Host.Apk is { } apk ? $"Version fournie avec ce serveur : {apk.VersionName}" : "Aucune version de l'app n'est fournie avec ce serveur.")
            </div>
        </div>
        <FluentButton Disabled="@(DownloadUrl is null)" IconStart="@(new Icons.Regular.Size20.QrCode())" OnClick="ShowDownloadQr">
            Afficher le QR code de téléchargement
        </FluentButton>
    </div>

    <h2 class="section-title">Sécurité</h2>
    <div class="settings-card column">
        <div class="settings-row">
            <FluentIcon Value="@(new Icons.Regular.Size20.LockClosed())" Color="Color.Custom" CustomColor="currentColor" />
            <div class="settings-text">
                <div class="settings-title">Mot de passe administrateur</div>
                <div class="caption">Il protège cette interface. Au moins 8 caractères.</div>
            </div>
        </div>
        <div class="password-form">
            <div>
                <FluentTextField TextFieldType="TextFieldType.Password" Label="Mot de passe actuel" @bind-Value="_current" Immediate="true" Style="width:100%"
                                 AutoComplete="current-password" />
            </div>
            <div>
                <FluentTextField TextFieldType="TextFieldType.Password" Label="Nouveau mot de passe" @bind-Value="_new" Immediate="true" Style="width:100%"
                                 AutoComplete="new-password" />
            </div>
            <div>
                <FluentTextField TextFieldType="TextFieldType.Password" Label="Confirmez le nouveau mot de passe" @bind-Value="_confirm" Immediate="true" Style="width:100%"
                                 AutoComplete="new-password" />
            </div>
            <FluentButton Appearance="Appearance.Accent" Disabled="@(!CanChangePassword)" OnClick="ChangePassword">Changer le mot de passe</FluentButton>
        </div>
        @if (_passwordMessage is not null)
        {
            <FluentMessageBar Intent="@(_passwordOk ? MessageIntent.Success : MessageIntent.Error)" AllowDismiss="false">@_passwordMessage</FluentMessageBar>
        }
    </div>

    <h2 class="section-title">À propos</h2>
    <div class="settings-card">
        <img src="img/app.png" alt="" width="20" height="20" />
        <div class="settings-text">
            <div class="settings-title">Mon Album PC @Version</div>
            <div class="caption">Logiciel libre, sous licence MIT.</div>
        </div>
        <a href="https://github.com/lgm42/mon-album-pc" target="_blank" rel="noopener">Code source sur GitHub ↗</a>
    </div>
</div>

<FluentDialog @onkeydown="OnDialogKey" Hidden="@(!_qrOpen)" HiddenChanged="h => _qrOpen = !h" Modal="true" TrapFocus="true" AriaLabel="Installer l'app sur un téléphone"
              Class="app-dialog" Style="--dialog-width: 420px;">
    @if (_qrOpen && Host.Apk is { } shipped && DownloadUrl is { } url)
    {
        <div class="dlg-content" tabindex="-1" @ref="_qrContent">
            <div class="dlg-header"><h2>Installer l'app sur un téléphone</h2></div>
            <div class="dlg-body download-qr">
                <img class="qr small" src="@QrCodes.DataUri(url)" alt="QR code de téléchargement" width="180" height="180" />
                <p>Scannez ce code avec l'appareil photo du téléphone Android pour télécharger Mon Album PC (version @shipped.VersionName).</p>
                <span class="mono caption">@url</span>
            </div>
            <div class="dlg-footer">
                <FluentButton OnClick="() => _qrOpen = false">Fermer</FluentButton>
            </div>
        </div>
    }
</FluentDialog>

@code {
    private static readonly string Version = Assembly.GetExecutingAssembly().GetName().Version?.ToString(3) ?? "";

    private bool _qrOpen;
    private bool _focusQr;
    private ElementReference _qrContent;
    private string? _current;
    private string? _new;
    private string? _confirm;
    private string? _passwordMessage;
    private bool _passwordOk;

    private string? DownloadUrl => Host.Apk is not null && Host.ServerError is null && Host.LanAddress is { } address
        ? $"http://{address}:{Host.DownloadPort}/"
        : null;

    private bool CanChangePassword => !string.IsNullOrEmpty(_current) && !string.IsNullOrEmpty(_new) && !string.IsNullOrEmpty(_confirm);

    private void OnDialogKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _qrOpen = false;
        }
    }

    private void ShowDownloadQr() => _qrOpen = _focusQr = DownloadUrl is not null;

    private const int MaxProblems = 20;
    private static readonly TimeSpan RefreshEvery = TimeSpan.FromMilliseconds(250);
    private DateTime _lastRefresh;
    private ProvenanceMarkerState _shownState;

    private Timer? _clock;

    protected override void OnInitialized()
    {
        _shownState = Marker.State;
        Marker.Changed += OnMarkerChanged;
        // Reading the catalog of a big album says nothing for a while: the elapsed time still moves.
        _clock = new Timer(_ =>
        {
            if (Marker.IsBusy)
            {
                _ = InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    // Raised on the marking thread for every file: the page follows at most four times a second, and at every change of step.
    private void OnMarkerChanged()
    {
        var now = DateTime.UtcNow;
        if (Marker.State == _shownState && now - _lastRefresh < RefreshEvery)
        {
            return;
        }
        _lastRefresh = now;
        _ = InvokeAsync(() =>
        {
            _shownState = Marker.State;
            StateHasChanged();
        });
    }

    private async Task ConfirmMarking()
    {
        if (Marker.Plan is not { Files.Count: > 0 } plan)
        {
            return;
        }
        var dialog = await Dialogs.ShowConfirmationAsync(
            $"{plan.Description} Seules les métadonnées changent : l'image n'est pas réenregistrée et chaque fichier garde sa date. "
            + "Le marquage se fait en arrière-plan, en priorité basse ; vous pouvez quitter cette page.",
            "Marquer", "Annuler", "Marquer la provenance des photos ?");
        if (!(await dialog.Result).Cancelled)
        {
            Marker.Mark();
        }
    }

    private static string ProgressText(ProvenanceProgress progress) => progress.Total > 0
        ? $"{progress.Step} {Formatting.Count(Math.Min(progress.Done + 1, progress.Total))} / {Formatting.Count(progress.Total)}"
          + (progress.File is null ? "" : $" · {progress.File}")
        : progress.Step;

    private string TimeText()
    {
        var text = $"Écoulé : {Duration(Marker.Elapsed)}";
        return Marker.Remaining is { } left ? $"{text} · reste environ {Duration(left)}" : text;
    }

    private static string Duration(TimeSpan duration) => duration.TotalSeconds < 60
        ? $"{Math.Max(1, (int)duration.TotalSeconds)} s"
        : duration.TotalMinutes < 60
            ? $"{(int)duration.TotalMinutes} min {duration.Seconds:00} s"
            : $"{(int)duration.TotalHours} h {duration.Minutes:00} min";

    public void Dispose()
    {
        _clock?.Dispose();
        Marker.Changed -= OnMarkerChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusQr && _qrOpen)
        {
            _focusQr = false;
            await _qrContent.FocusAsync();
        }
    }

    private void ChangePassword()
    {
        _passwordOk = false;
        if (!Password.Verify(_current ?? ""))
        {
            _passwordMessage = "Le mot de passe actuel est incorrect.";
            return;
        }
        if (_new != _confirm)
        {
            _passwordMessage = "Les deux nouveaux mots de passe ne sont pas identiques.";
            return;
        }
        if (Password.Set(_new ?? "") is { } weak)
        {
            _passwordMessage = weak;
            return;
        }
        // Every sign-in, this one included, now needs the new password.
        Navigation.NavigateTo("login?changed=1", forceLoad: true);
    }
}
