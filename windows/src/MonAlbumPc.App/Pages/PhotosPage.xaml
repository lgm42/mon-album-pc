<UserControl x:Class="MonAlbumPc.App.Pages.PhotosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24,20">
        <TextBlock Style="{StaticResource PageTitle}" Text="Photos" VerticalAlignment="Top" />
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <Image Source="pack://application:,,,/Assets/app.png" Width="96" Height="96" />
            <TextBlock Style="{StaticResource Subtitle}" Margin="0,20,0,8" HorizontalAlignment="Center"
                       Text="Aucune photo pour l'instant." />
            <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center"
                       Text="Ajoutez un téléphone pour commencer. Ses photos et vidéos arriveront ici automatiquement, en Wi-Fi." />
            <Button Style="{StaticResource AccentButtonStyle}" Margin="0,20,0,0" HorizontalAlignment="Center"
                    Padding="16,6" Content="Ajouter un téléphone" Click="OnAddPhone" />
        </StackPanel>
    </Grid>
</UserControl>
