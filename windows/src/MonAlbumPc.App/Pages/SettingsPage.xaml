<UserControl x:Class="MonAlbumPc.App.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20" MaxWidth="1000">
            <TextBlock Style="{StaticResource PageTitle}" Text="Réglages" Margin="0,0,0,20" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="Démarrage" Margin="0,0,0,8" />
            <Border Style="{StaticResource Card}" MinHeight="68">
                <DockPanel>
                    <CheckBox x:Name="AutostartToggle" DockPanel.Dock="Right" VerticalAlignment="Center" Content="Activé"
                              Checked="OnAutostartChanged" Unchecked="OnAutostartChanged" />
                    <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE7E8;" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Lancer avec Windows" />
                        <TextBlock Style="{StaticResource Caption}" Text="L'app démarre réduite dans la zone de notification pour recevoir les photos." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Réseau" Margin="0,24,0,8" />
            <Border Style="{StaticResource Card}" MinHeight="68">
                <DockPanel>
                    <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE968;" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NetworkTitle" />
                        <TextBlock x:Name="NetworkDetail" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Application Android" Margin="0,24,0,8" />
            <Border Style="{StaticResource Card}" MinHeight="68">
                <DockPanel>
                    <Button x:Name="ApkQrButton" DockPanel.Dock="Right" VerticalAlignment="Center"
                            Content="Afficher le QR code de téléchargement" Click="OnShowApkQr" />
                    <TextBlock Style="{StaticResource Icon}" FontSize="20" Text="&#xE8EA;" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Mon Album PC pour Android" />
                        <TextBlock x:Name="ApkVersion" Style="{StaticResource Caption}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="À propos" Margin="0,24,0,8" />
            <Border Style="{StaticResource Card}" MinHeight="68">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" VerticalAlignment="Center"
                            Content="Code source sur GitHub ↗" Click="OnOpenGitHub" />
                    <Image Source="pack://application:,,,/Assets/app.png" Width="20" Height="20" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText" />
                        <TextBlock Style="{StaticResource Caption}" Text="Logiciel libre, sous licence MIT." />
                    </StackPanel>
                </DockPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
