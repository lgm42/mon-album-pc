<UserControl x:Class="MonAlbumPc.App.Activity.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MonAlbumPc.App.Activity">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <DataTemplate x:Key="WorkTemplate" DataType="{x:Type local:WorkRow}">
            <Border Margin="0,0,0,4" Padding="16,12" CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE895;" Margin="0,0,10,0"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding Step}" Margin="8,0,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar Height="3" Margin="0,10,0,0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" FontFamily="{StaticResource MonoFont}"
                                   Text="{Binding Item}" TextTrimming="CharacterEllipsis" MaxWidth="360" Margin="16,0,0,0"
                                   ToolTip="{Binding Item}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Pace}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="EventTemplate" DataType="{x:Type local:EventRow}">
            <Border x:Name="Row" Margin="0,0,0,4" Padding="16,8" CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Time}" Margin="0,1,0,0" />
                    <TextBlock x:Name="LevelIcon" Grid.Column="1" Style="{StaticResource Icon}" FontSize="14" VerticalAlignment="Top"
                               Margin="0,1,0,0" Text="&#xE946;" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="Text" Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWarning}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                    <Setter TargetName="LevelIcon" Property="Text" Value="&#xE7BA;" />
                    <Setter TargetName="LevelIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="LevelIcon" Property="Text" Value="&#xEA39;" />
                    <Setter TargetName="LevelIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,0">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Activité" Margin="0,0,0,16" />
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <TextBlock Style="{StaticResource SectionTitle}" Text="En cours" Margin="0,0,0,8" />
                <TextBlock x:Name="NoWork" Style="{StaticResource Secondary}" Margin="0,0,0,8" />
                <ItemsControl x:Name="Running" ItemTemplate="{StaticResource WorkTemplate}" />

                <DockPanel Margin="0,24,0,8">
                    <CheckBox x:Name="ProblemsOnly" DockPanel.Dock="Right" Content="Avertissements et erreurs uniquement"
                              Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Événements récents" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="NoEvents" Style="{StaticResource Secondary}" Margin="0,0,0,8" />
                <ItemsControl x:Name="Events" ItemTemplate="{StaticResource EventTemplate}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
