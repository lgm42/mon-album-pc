<UserControl x:Class="MonAlbumPc.App.Tags.TagsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MonAlbumPc.App.Tags">
    <UserControl.Resources>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,0" MaxWidth="900" HorizontalAlignment="Left">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Padding="14,6" Click="OnNewTag" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE710;" Margin="0,0,8,0" />
                    <TextBlock Text="Nouveau tag" />
                </StackPanel>
            </Button>
            <TextBlock Style="{StaticResource PageTitle}" Text="Tags" />
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Margin="0,0,0,16" MaxWidth="720" HorizontalAlignment="Left"
                   Text="Les tags sont écrits dans les photos elles-mêmes (métadonnées XMP, ou fichier .xmp à côté des vidéos) : digiKam, Lightroom ou l'Explorateur de Windows les voient aussi. « / » range un tag sous un autre : Bricolage/ESP32." />

        <!-- Operations on tags in progress, as on the activity board. -->
        <ItemsControl x:Name="RunningList" DockPanel.Dock="Top">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar Height="3" Margin="0,6,0,0" Maximum="1" Value="{Binding Fraction, Mode=OneWay}"
                                         IsIndeterminate="{Binding Indeterminate, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- New tag, new sub-tag, rename: one editor above the list. -->
        <Border x:Name="Editor" DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button DockPanel.Dock="Right" Content="Annuler" Click="OnCancelEditor" Padding="12,4" />
                    <TextBlock x:Name="EditorTitle" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
                <local:TagBox x:Name="EditorBox" />
            </StackPanel>
        </Border>

        <StackPanel x:Name="EmptyState" DockPanel.Dock="Top" Margin="0,40,0,0" Visibility="Collapsed" HorizontalAlignment="Center">
            <TextBlock Style="{StaticResource Subtitle}" Text="Aucun tag pour l'instant." HorizontalAlignment="Center" />
            <TextBlock Style="{StaticResource Secondary}" Margin="0,8,0,0" TextAlignment="Center"
                       Text="Créez-en un ici, ou sélectionnez des photos dans la page Photos puis « Ajouter un tag »." />
        </StackPanel>

        <Border x:Name="TreeCard" Style="{StaticResource Card}" Padding="0" Margin="0,0,0,24">
            <ListBox x:Name="TagList" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Back" Background="Transparent" BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:TagRow}">
                        <DockPanel MinHeight="42" Margin="{Binding Indent}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,8,0">
                                <Button Style="{StaticResource RowButton}" Content="&#xE710;" ToolTip="Nouveau sous-tag" Tag="{Binding Name}" Click="OnNewChild" />
                                <Button Style="{StaticResource RowButton}" Content="&#xE70F;" ToolTip="Renommer ou fusionner" Tag="{Binding Name}" Click="OnRename" />
                                <Button Style="{StaticResource RowButton}" Content="&#xE74D;" ToolTip="Supprimer" Tag="{Binding Name}" Click="OnDelete" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="13" Text="&#xE8EC;" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Button DockPanel.Dock="Left" Style="{StaticResource LinkButton}" Tag="{Binding Name}" Click="OnShowPhotos"
                                    ToolTip="{Binding ShowText}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Leaf}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Button>
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding CountText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </DockPanel>
</UserControl>
