<UserControl x:Class="MonAlbumPc.App.Tags.TagBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MonAlbumPc.App.Tags">
    <!-- A tag typed with the library's tags proposed as you type: Enter takes the highlighted one or creates the typed name. -->
    <StackPanel>
        <Grid>
            <TextBox x:Name="Input" MaxLength="120" PreviewKeyDown="OnKey" TextChanged="OnTextChanged" />
            <TextBlock x:Name="Hint" Style="{StaticResource Caption}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                       Text="Tag (« / » pour un sous-tag)" />
        </Grid>
        <ListBox x:Name="Suggestions" Visibility="Collapsed" MaxHeight="260" Margin="0,4,0,0" Focusable="False"
                 BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                 Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="OnSuggestionClick">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="MinHeight" Value="30" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:TagSuggestion}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Caption}" Text="{Binding Detail}" Margin="12,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="Label" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCreate}" Value="True">
                            <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </StackPanel>
</UserControl>
