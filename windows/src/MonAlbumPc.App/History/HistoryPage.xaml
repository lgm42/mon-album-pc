<UserControl x:Class="MonAlbumPc.App.History.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MonAlbumPc.App.History">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <DataTemplate x:Key="SessionTemplate" DataType="{x:Type local:SessionRow}">
            <Border x:Name="Row" Margin="0,0,0,4" Padding="16,12" CornerRadius="4" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="80" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Time}" VerticalAlignment="Top" Margin="0,1,0,0" />
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Phone}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Album}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <DockPanel Grid.Column="2">
                        <TextBlock x:Name="StateIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" VerticalAlignment="Top"
                                   Margin="0,2,10,0" Text="&#xE73E;" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <StackPanel>
                            <TextBlock x:Name="Title" Text="{Binding Title}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Detail}" Margin="0,2,0,0"
                                       Visibility="{Binding HasDetail, Converter={StaticResource Visible}}" />
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" Text="{Binding Hint}" Margin="0,4,0,0"
                                       Visibility="{Binding HasHint, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="{Binding ChannelIcon}" Margin="0,0,6,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Channel}" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                    <Setter TargetName="StateIcon" Property="Text" Value="&#xEA39;" />
                    <Setter TargetName="StateIcon" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24,20,24,0">
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageTitle}" Text="Historique" Margin="0,0,0,16" />
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,16">
            <ComboBox x:Name="AlbumFilter" Width="200" Margin="0,0,8,0" SelectionChanged="OnFilterChanged" />
            <ComboBox x:Name="PhoneFilter" Width="220" Margin="0,0,16,0" SelectionChanged="OnFilterChanged" />
            <CheckBox x:Name="ErrorsOnly" Content="Erreurs uniquement" VerticalAlignment="Center"
                      Checked="OnFilterChanged" Unchecked="OnFilterChanged" />
        </StackPanel>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="Days" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:DayGroup}">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding Sessions}" ItemTemplate="{StaticResource SessionTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" FontSize="40" HorizontalAlignment="Center" Text="&#xE81C;"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock x:Name="EmptyTitle" Style="{StaticResource Subtitle}" Margin="0,16,0,4" HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyText" Style="{StaticResource Secondary}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
