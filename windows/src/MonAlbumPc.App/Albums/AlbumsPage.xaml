<UserControl x:Class="MonAlbumPc.App.Albums.AlbumsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MonAlbumPc.App.Albums">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <DataTemplate x:Key="PhoneTemplate" DataType="{x:Type local:PhoneRow}">
            <Grid MinHeight="56" Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="32" Height="32" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Style="{StaticResource Icon}" HorizontalAlignment="Center" Text="&#xE8EA;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Model}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Caption}" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Text="Doublon probable : même modèle qu'un autre téléphone de l'album (menu … › Fusionner)"
                               TextWrapping="Wrap" Visibility="{Binding IsLikelyDuplicate, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Style="{StaticResource Caption}" Text="Dernière sauvegarde" HorizontalAlignment="Right" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE7BA;" Margin="0,0,4,0"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                   Visibility="{Binding IsStale, Converter={StaticResource Visible}}" />
                        <TextBlock Text="{Binding LastBackup}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStale}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Caption}" Text="Reçus" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding Received}" HorizontalAlignment="Right" />
                </StackPanel>
                <Button Grid.Column="4" Style="{StaticResource IconButton}" Margin="8,0,0,0" Content="&#xE712;"
                        ToolTip="Plus d'actions" Tag="{Binding}" Click="OnPhoneMenu">
                    <Button.ContextMenu>
                        <!-- Own font: a context menu inherits the icon font of the button that opens it. -->
                        <ContextMenu FontFamily="{x:Static SystemFonts.MessageFontFamily}" FontSize="14">
                            <MenuItem Header="Fusionner avec" />
                            <MenuItem Header="Dissocier…" Click="OnUnpair" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="AlbumTemplate" DataType="{x:Type local:AlbumCard}">
            <Border Style="{StaticResource Card}" Margin="0,0,16,16" Width="520" VerticalAlignment="Top">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource IconButton}" Content="&#xE70F;" ToolTip="Modifier l'album"
                                    Tag="{Binding}" Click="OnEditAlbum" />
                            <!-- Wrapped so the tooltip still shows while the button is disabled. -->
                            <Border Background="Transparent" ToolTip="{Binding DeleteTooltip}">
                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;" Tag="{Binding}"
                                        IsEnabled="{Binding CanDelete}" Click="OnDeleteAlbum" />
                            </Border>
                        </StackPanel>
                        <Border Width="40" Height="40" CornerRadius="20" Background="{Binding Color}" VerticalAlignment="Top">
                            <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="16"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Subtitle}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Caption}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Margin="0,12,0,0" Padding="12,6" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Ouvrir" Tag="{Binding}" Click="OnOpenFolder" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Border>

                    <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,4" Text="Téléphones" />
                    <ItemsControl ItemsSource="{Binding Phones}" ItemTemplate="{StaticResource PhoneTemplate}" />
                    <TextBlock Style="{StaticResource Secondary}" Margin="0,4" Text="Aucun téléphone n'est relié à cet album."
                               Visibility="{Binding CanDelete, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource LinkButton}" Margin="0,8,0,0" HorizontalAlignment="Left"
                            Tag="{Binding}" Click="OnAddPhoneToAlbum">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE710;" Margin="0,0,8,0" />
                            <TextBlock Text="Ajouter un téléphone à cet album" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel Margin="24,20,8,0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,16,20">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Margin="0,0,8,0" Padding="12,5" Click="OnNewAlbum">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE710;" Margin="0,0,8,0" />
                        <TextBlock Text="Nouvel album" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource AccentButtonStyle}" Padding="12,5" Click="OnAddPhone">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE8EA;" Margin="0,0,8,0" />
                        <TextBlock Text="Ajouter un téléphone" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Albums et téléphones" />
        </DockPanel>

        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Albums}" ItemTemplate="{StaticResource AlbumTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
                        Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                <TextBlock Style="{StaticResource Subtitle}" HorizontalAlignment="Center" Margin="0,0,0,8" Text="Aucun album pour l'instant." />
                <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center"
                           Text="Un album, c'est une personne et le dossier où ses photos seront rangées. Créez-en un, puis reliez-lui un téléphone." />
                <Button Style="{StaticResource AccentButtonStyle}" Margin="0,20,0,0" Padding="16,6" HorizontalAlignment="Center"
                        Content="Créer un album" Click="OnNewAlbum" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
