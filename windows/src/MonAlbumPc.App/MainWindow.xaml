<Window x:Class="MonAlbumPc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mon Album PC"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1200" Height="800" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="272" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <DockPanel Grid.Column="0" Margin="4,8,4,8">
            <ListBox x:Name="FooterNav" DockPanel.Dock="Bottom" Style="{StaticResource NavList}"
                     SelectionChanged="OnNavigate">
                <ListBoxItem Tag="settings">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" />
                        <TextBlock Margin="16,0,0,0" Text="Réglages" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>

            <!-- Status card -->
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="4,0,4,8" Padding="12,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StatusIcon" Style="{StaticResource Icon}" FontSize="14" Text="&#xE73E;"
                                   Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="StatusTitle" Margin="8,0,0,0" FontWeight="SemiBold" Text="Prêt à recevoir les photos" />
                    </StackPanel>
                    <TextBlock x:Name="StatusDetail" Style="{StaticResource Caption}" Margin="22,2,0,0" TextWrapping="Wrap" />
                    <ProgressBar x:Name="StatusProgress" Height="3" Margin="22,8,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <ListBox x:Name="MainNav" Style="{StaticResource NavList}" SelectionChanged="OnNavigate">
                <ListBoxItem Tag="photos">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE91B;" />
                        <TextBlock Margin="16,0,0,0" Text="Photos" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="map">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE707;" />
                        <TextBlock Margin="16,0,0,0" Text="Carte" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="albums">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8EA;" />
                        <TextBlock Margin="16,0,0,0" Text="Albums et téléphones" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem Tag="history">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE81C;" />
                        <TextBlock Margin="16,0,0,0" Text="Historique" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
        </DockPanel>

        <!-- Content layer -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1,1,0,0"
                CornerRadius="8,0,0,0">
            <ContentControl x:Name="Page" />
        </Border>
    </Grid>
</Window>
