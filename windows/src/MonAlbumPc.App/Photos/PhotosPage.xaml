<UserControl x:Class="MonAlbumPc.App.Photos.PhotosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MonAlbumPc.App.Photos"
             Focusable="True" PreviewKeyDown="OnKeyDown">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <Style x:Key="CommandButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="32" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FilterItem" TargetType="ListBoxItem" BasedOn="{StaticResource NavItem}">
            <Setter Property="Margin" Value="0,1" />
        </Style>

        <DataTemplate x:Key="FilterTemplate" DataType="{x:Type local:FilterEntry}">
            <DockPanel MinHeight="32" LastChildFill="True">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding Dot}" Margin="0,0,10,0" VerticalAlignment="Center"
                         Visibility="{Binding HasDot, Converter={StaticResource Visible}}" />
                <TextBlock x:Name="Label" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsYear}" Value="True">
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsYear}" Value="False">
                    <Setter TargetName="Label" Property="Margin" Value="0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:MonthRow}">
            <StackPanel Orientation="Horizontal" Margin="0,16,0,8">
                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Count}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Bottom" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:TilesRow}">
            <ItemsControl ItemsSource="{Binding Tiles}" Margin="0,0,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PhotoTile}">
                        <Grid Width="{Binding DataContext.Size, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              Height="{Binding DataContext.Size, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                              Margin="0,0,4,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                              MouseLeftButtonDown="OnTileClick" Cursor="Hand" ToolTip="{Binding Name}">
                            <Grid.Clip>
                                <RectangleGeometry RadiusX="4" RadiusY="4" Rect="0,0,2000,2000" />
                            </Grid.Clip>
                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            <Border Background="#9E000000" CornerRadius="4" Padding="6,2" Margin="6"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Visibility="{Binding IsVideo, Converter={StaticResource Visible}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" FontSize="10" Foreground="White" Text="&#xE768;" Margin="0,0,4,0" />
                                    <TextBlock Foreground="White" FontSize="12" Text="Vidéo" />
                                </StackPanel>
                            </Border>
                            <Border BorderThickness="2" CornerRadius="4" BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                    Visibility="{Binding IsSelected, Converter={StaticResource Visible}}">
                                <Border BorderThickness="2" CornerRadius="2" BorderBrush="White" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="Library">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="216" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Filters -->
            <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,20,12,12">
                        <TextBlock Style="{StaticResource Caption}" Text="Albums" Margin="8,0,0,6" />
                        <ListBox x:Name="AlbumList" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource FilterItem}"
                                 ItemTemplate="{StaticResource FilterTemplate}" SelectionChanged="OnAlbumFilter" />
                        <TextBlock Style="{StaticResource Caption}" Text="Dates" Margin="8,20,0,6" />
                        <ListBox x:Name="DateList" Style="{StaticResource NavList}" ItemContainerStyle="{StaticResource FilterItem}"
                                 ItemTemplate="{StaticResource FilterTemplate}" SelectionChanged="OnDateFilter" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Grid -->
            <DockPanel Grid.Column="1" Margin="24,20,8,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Photos" />
                    <TextBlock x:Name="Caption" Style="{StaticResource Secondary}" Margin="12,0,0,4" VerticalAlignment="Bottom" />
                </StackPanel>

                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="4" Margin="0,0,16,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="11" Text="&#xE91B;" Margin="4,0,4,0" />
                            <Slider x:Name="SizeSlider" Width="90" Minimum="96" Maximum="260" Value="150" SmallChange="4"
                                    VerticalAlignment="Center" ValueChanged="OnSizeChanged" />
                            <TextBlock Style="{StaticResource Icon}" FontSize="17" Text="&#xE91B;" Margin="4,0,6,0" />
                            <ToggleButton x:Name="InfoToggle" IsChecked="True" Width="36" Height="32" Padding="0" ToolTip="Informations"
                                          Checked="OnInfoToggle" Unchecked="OnInfoToggle">
                                <TextBlock Style="{StaticResource Icon}" FontSize="14" Text="&#xE946;" />
                            </ToggleButton>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RotateLeftButton" Style="{StaticResource CommandButton}" ToolTip="Pivoter à gauche" Click="OnRotateLeft">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform ScaleX="-1" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Button>
                            <Button x:Name="RotateRightButton" Style="{StaticResource CommandButton}" ToolTip="Pivoter à droite"
                                    Content="&#xE7AD;" Click="OnRotateRight" />
                            <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <Button x:Name="DeleteButton" Style="{StaticResource CommandButton}" ToolTip="Supprimer" Content="&#xE74D;" Click="OnDelete" />
                            <Button x:Name="ExplorerButton" Style="{StaticResource CommandButton}" ToolTip="Ouvrir dans l'Explorateur"
                                    Content="&#xE838;" Click="OnOpenInExplorer" />
                            <Button x:Name="FullScreenButton" Style="{StaticResource CommandButton}" ToolTip="Afficher en plein écran"
                                    Content="&#xE740;" Click="OnFullScreen" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <Grid>
                    <ListBox x:Name="Rows" BorderThickness="0" Background="Transparent" Padding="0"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SizeChanged="OnRowsSizeChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Visibility="Collapsed">
                        <Image Source="pack://application:,,,/Assets/app.png" Width="96" Height="96" />
                        <TextBlock Style="{StaticResource Subtitle}" Margin="0,20,0,8" HorizontalAlignment="Center" Text="Aucune photo pour l'instant." />
                        <TextBlock Style="{StaticResource Secondary}" TextAlignment="Center"
                                   Text="Ajoutez un téléphone pour commencer. Ses photos et vidéos arriveront ici automatiquement, en Wi-Fi." />
                        <Button Style="{StaticResource AccentButtonStyle}" Margin="0,20,0,0" HorizontalAlignment="Center"
                                Padding="16,6" Content="Ajouter un téléphone" Click="OnAddPhone" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- Information pane -->
            <Border x:Name="InfoPane" Grid.Column="2" Width="288" BorderThickness="1,0,0,0"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Style="{StaticResource Subtitle}" Text="Informations" Margin="0,0,0,16" />
                        <TextBlock x:Name="NoSelection" Style="{StaticResource Secondary}"
                                   Text="Sélectionnez une photo pour voir sa date, son téléphone d'origine et ses dimensions." />
                        <StackPanel x:Name="Details" Visibility="Collapsed">
                            <TextBlock x:Name="InfoName" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <ItemsControl x:Name="InfoLines">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,0,0,14">
                                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" VerticalAlignment="Top"
                                                       Margin="0,2,12,0" Text="{Binding Icon}" />
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Caption}" Text="{Binding Label}" />
                                                <TextBlock Text="{Binding Value}" TextWrapping="Wrap" ToolTip="{Binding Value}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Full-screen viewer -->
        <Grid x:Name="Viewer" Background="#1C1C1C" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="8,0" TextElement.Foreground="White">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CommandButton}" Foreground="White" ToolTip="Pivoter à gauche" Click="OnRotateLeft">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Foreground="White" ToolTip="Pivoter à droite" Content="&#xE7AD;" Click="OnRotateRight" />
                    <Button Style="{StaticResource CommandButton}" Foreground="White" ToolTip="Supprimer" Content="&#xE74D;" Click="OnDelete" />
                    <Button Style="{StaticResource CommandButton}" Foreground="White" ToolTip="Ouvrir dans l'Explorateur" Content="&#xE838;" Click="OnOpenInExplorer" />
                </StackPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource CommandButton}" Foreground="White" ToolTip="Retour (Échap)"
                        Content="&#xE72B;" Click="OnCloseViewer" VerticalAlignment="Center" />
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="ViewerName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ViewerPosition" FontSize="12" Opacity="0.7" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1" Margin="16,8,16,24">
                <Image x:Name="ViewerImage" Stretch="Uniform" Margin="56,0" />
                <MediaElement x:Name="ViewerVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Margin="56,0"
                              Visibility="Collapsed" MediaEnded="OnVideoEnded" />
                <Button x:Name="PlayButton" Width="64" Height="64" Visibility="Collapsed" Click="OnPlay"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border CornerRadius="32" Background="#B0000000">
                                <TextBlock Style="{StaticResource Icon}" FontSize="24" Foreground="White" Text="&#xE768;"
                                           HorizontalAlignment="Center" Margin="4,0,0,0" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="PreviousButton" Style="{StaticResource CommandButton}" Width="40" Height="40" Foreground="White"
                        HorizontalAlignment="Left" Content="&#xE76B;" ToolTip="Précédente" Click="OnPrevious" />
                <Button x:Name="NextButton" Style="{StaticResource CommandButton}" Width="40" Height="40" Foreground="White"
                        HorizontalAlignment="Right" Content="&#xE76C;" ToolTip="Suivante" Click="OnNext" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
